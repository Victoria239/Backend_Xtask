# ─── Database ────────────────────────────────────────────────
DB_USER=xtask
DB_PASSWORD=xtask_dev_2024
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xtask_db
DATABASE_URL=postgresql+asyncpg://xtask:xtask_dev_2024@localhost:5432/xtask_db

# ─── Redis ───────────────────────────────────────────────────
