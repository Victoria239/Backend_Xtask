# ─── Database ────────────────────────────────────────────────
DB_USER=xtask
DB_PASSWORD=xtask_dev_2024
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xtask_db
DATABASE_URL=postgresql+asyncpg://xtask:xtask_dev_2024@localhost:5432/xtask_db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Auth ──────────────────────────────────────────────
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── Server ──────────────────────────────────────────────────
ENVIRONMENT=development
GATEWAY_PORT=8000
GATEWAY_MODE=monolith  # "monolith" (all-in-one) or "proxy" (microservices)
LOG_LEVEL=DEBUG

# ─── Microservice URLs (only used in proxy mode) ────────────
AUTH_SERVICE_URL=http://localhost:8001
PROJECTS_SERVICE_URL=http://localhost:8002
EMPLOYEES_SERVICE_URL=http://localhost:8003
FINANCE_SERVICE_URL=http://localhost:8004
PAYROLL_SERVICE_URL=http://localhost:8005
KPIS_SERVICE_URL=http://localhost:8006
SKILLS_SERVICE_URL=http://localhost:8007
DASHBOARD_SERVICE_URL=http://localhost:8008

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Email (SendGrid) ───────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@xtask.com
